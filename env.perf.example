# Copy these into backend/.env only on load-test machines.
# Do not use these values for normal local development.

# Longer access tokens for soak / multi-minute smoke+stress runs
JWT_ACCESS_TOKEN_MINUTES=120

# Full dataset seed (~200 register/login from one IP) + k6 logins
RATE_LIMIT_AUTH_CREDENTIALS_MAX_HITS=2000
RATE_LIMIT_AUTH_SESSION_MAX_HITS=2000

# Friendship + direct conversation creation during seed
RATE_LIMIT_FRIENDSHIP_WRITE_MAX_HITS=1000
RATE_LIMIT_CONVERSATION_WRITE_MAX_HITS=1000

# Historical seed (~50–100 msgs/pair) + stress send path
RATE_LIMIT_MESSAGE_SEND_MAX_HITS=600
RATE_LIMIT_MESSAGE_PROGRESS_MAX_HITS=1200
RATE_LIMIT_PRESENCE_HEARTBEAT_MAX_HITS=600
